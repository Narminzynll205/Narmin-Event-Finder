@model ProfileViewModel
@{
    ViewData["Title"] = "Profil";
}

<div class="container page-container py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <span class="rounded-circle bg-brand text-white d-inline-flex align-items-center justify-content-center fs-3" style="width:64px;height:64px;">
            @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "?")
        </span>
        <div>
            <h1 class="mb-0">@Model.FullName</h1>
            <p class="text-muted mb-1">@Model.Email</p>
            @foreach (var role in Model.Roles)
            {
                <span class="badge badge-category me-1">@role</span>
            }
        </div>
    </div>

    @if (Model.Roles.Contains(Roles.Organizer))
    {
        <h4 class="section-title">Yaratdığım tədbirlər</h4>
        @if (!Model.OrganizedEvents.Any())
        {
            <p class="text-muted">Hələ tədbir yaratmamısınız.</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mb-4">
                @foreach (var ev in Model.OrganizedEvents)
                {
                    @await Html.PartialAsync("_EventCard", ev)
                }
            </div>
        }
    }

    <h4 class="section-title">Qoşulduğum tədbirlər</h4>
    @if (!Model.JoinedEvents.Any())
    {
        <p class="text-muted">Hələ heç bir tədbirə qoşulmamısınız.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
            @foreach (var ev in Model.JoinedEvents)
            {
                @await Html.PartialAsync("_EventCard", ev)
            }
        </div>
    }
</div>
