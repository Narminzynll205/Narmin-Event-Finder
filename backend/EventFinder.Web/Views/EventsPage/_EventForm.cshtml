@model EventFormViewModel

<form asp-action="@(Model.Id > 0 ? "Edit" : "Create")" asp-route-id="@(Model.Id > 0 ? Model.Id : (int?)null)" method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="col-md-6">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<EventCategory>()"></select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="StartDateTime" class="form-label"></label>
        <input asp-for="StartDateTime" type="datetime-local" class="form-control" />
        <span asp-validation-for="StartDateTime" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MaxParticipants" class="form-label"></label>
        <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label class="form-label">Xəritədən yer seçin (klikləyin)</label>
        <div id="pickerMap" class="map-picker"></div>
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label asp-for="Latitude" class="form-label"></label>
                <input asp-for="Latitude" id="latField" class="form-control" readonly />
                <span asp-validation-for="Latitude" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Longitude" class="form-label"></label>
                <input asp-for="Longitude" id="lngField" class="form-control" readonly />
                <span asp-validation-for="Longitude" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-brand">Yadda saxla</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
    </div>
</form>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        var initialLat = @(Model.Latitude != 0 ? Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture) : "40.3777");
        var initialLng = @(Model.Longitude != 0 ? Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture) : "49.8920");
        var hasInitialMarker = @(Model.Latitude != 0 || Model.Longitude != 0 ? "true" : "false");
    </script>
    <script src="~/js/event-form.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
